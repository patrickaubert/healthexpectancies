document()
build()
library(tidyverse)
# *** extraction des données (repris du code du package healthexpectancies)
urlproj2026 <- "https://www.insee.fr/fr/statistiques/fichier/8990852/00_central.xlsx"
projMale <- openxlsx::read.xlsx(urlproj2026, sheet = "populationH", rows=c(2:108)) # rows=c(2,102:108))
names(projMale)[1] <- "age0101"
projMale <- projMale %>% pivot_longer(-c("age0101"), names_to = "year", values_to = "popx0101")
projFemale <- openxlsx::read.xlsx(urlproj2026,sheet = "populationF", rows=c(2:108)) # rows=c(2,102:108))
names(projFemale)[1] <- "age0101"
projFemale <- projFemale %>% pivot_longer(-c("age0101"), names_to = "year", values_to = "popx0101")
tab <- rbind(
projFemale %>% mutate(sex = "Femmes"),
projMale %>% mutate(sex = "Hommes")
) %>%
#filter(year %in% unique(FRInseePopulationForecast2021$year), popx0101>0) %>%
filter( popx0101>0) %>%
mutate(type.obs = case_when(year<= 2022 ~ "observed",year >= 2023 ~ "forecasted") %>% as.factor(),
geo = case_when(year <= 1994 ~  "Metropolitan France",
year <= 2013 ~ "France excluding Mayotte",
TRUE ~  "France"),
age0101 = as.numeric(str_extract(age0101,"^[[:digit:]]+")),
sex = as.factor(sex),
year=as.numeric(year),
geo="france")
# *** graphique
tab <- bind_rows(
tab,
tab |>
mutate(sex = "Ensemble") |>
group_by(age0101,year,sex,type.obs,geo) |> summarise(popx0101 = sum(popx0101) ) |> ungroup()
) |>
group_by(year,sex,type.obs,geo) |> filter(popx0101 == max(popx0101)) |> ungroup() |>
mutate(generation = year-1-age0101)
tab <- tab |>
arrange(sex,year) |>
group_by(sex) |> mutate(gen_change = ifelse(generation!=lag(generation) | is.na(lag(generation)),paste0("Génération\nnée en",generation),"")) |> ungroup()
g <- tab |>
filter(sex=="Ensemble") |>
mutate(generation = as.character(generation)) |>
ggplot(aes(y=age0101,x=year,colour=generation)) +
geom_vline(xintercept=1994.5,colour="gray", linewidth=1.25) +
geom_vline(xintercept=2013.5,colour="gray", linewidth=1.25) +
geom_point() +
geom_line() +
geom_text(aes(label=gen_change), vjust=0.5, hjust=1) +
theme(legend.position="none") +
labs(x=NULL,y=NULL,
title = "Quelle génération est la plus nombreuse selon l'année ?",
caption = "Source : Insee, estimations de population et projections de population 2026. Graphique : Patrick Aubert.")
# ** graphique un peu plus propre
library(tidyverse)
library(ggrepel)
# -------------------------------------------------------------------------
# 1. Préparation des données
# -------------------------------------------------------------------------
df <- tab |>
filter(sex == "Ensemble") |>
mutate(generation = as.character(generation)) |>
arrange(year)
# Point où la génération la plus nombreuse est la plus âgée
# (= l'âge maximal atteint, toutes années et générations confondues,
#   par la génération qui est la plus nombreuse à cette date)
point_max <- df |>
filter(age0101 == max(age0101, na.rm = TRUE)) |>
slice(1)
annee_max   <- point_max$year
age_max     <- point_max$age0101
gen_max     <- point_max$generation
label_max <- paste0(
"En ", annee_max, ", la génération la plus nombreuse\n",
"est celle qui a ", age_max, " ans (née en ", gen_max, ")"
)
# -------------------------------------------------------------------------
# 2. Champs territoriaux (bandes + étiquettes)
# -------------------------------------------------------------------------
champs <- tibble(
xmin  = c(1962, 1995, 2014),
xmax  = c(1994, 2013, 2070),
champ = c("France métropolitaine", "France hors Mayotte", "France y compris Mayotte")
) |>
mutate(xmid = (xmin + xmax) / 2)
y_max_plot <- max(df$age0101, na.rm = TRUE)
y_label_champ <- y_max_plot * 1.07   # un peu au-dessus des données
# -------------------------------------------------------------------------
# 3. Graphique
# -------------------------------------------------------------------------
g <- ggplot(df, aes(x = year, y = age0101)) +
# bandes verticales délimitant les champs (alternance très légère)
geom_rect(
data = champs,
aes(xmin = xmin - 0.5, xmax = xmax + 0.5, ymin = -Inf, ymax = Inf),
inherit.aes = FALSE,
fill = rep(c("grey95", "white"), length.out = nrow(champs)),
alpha = 0.6
) +
# traits de séparation entre les champs
geom_vline(xintercept = c(1994.5, 2013.5), colour = "grey75",
linewidth = 0.5, linetype = "dashed") +
# étiquettes des champs en haut du graphique
geom_text(
data = champs,
aes(x = xmid, y = y_label_champ, label = champ),
inherit.aes = FALSE,
colour = "grey45", size = 3, fontface = "italic"
) +
# ligne sobre reliant les années successives (et non les générations)
geom_line(aes(group = 1), colour = "grey60", linewidth = 0.6) +
# points colorés par génération
geom_point(aes(colour = generation), size = 2) +
# étiquettes des changements de génération (réparties automatiquement pour éviter les chevauchements)
geom_text_repel(
aes(label = gen_change, colour = generation),
na.rm = TRUE, size = 2.9, lineheight = 0.85, fontface = "bold",
show.legend = FALSE, seed = 42,
min.segment.length = 0,      # affiche toujours le petit trait de liaison si déplacée
segment.size = 0.3, segment.colour = "grey50",
box.padding = 0.3, point.padding = 0.3,
max.overlaps = Inf, force = 2
) +
# mise en évidence du point "génération la plus nombreuse la plus âgée"
geom_point(
data = point_max, aes(x = year, y = age0101),
colour = "black", size = 3.2, shape = 21, fill = NA, stroke = 1
) +
annotate(
"curve",
x = annee_max - 12, y = age_max - 6,
xend = annee_max - 1, yend = age_max - 1,
curvature = -0.3, linewidth = 0.5, colour = "grey20",
arrow = arrow(length = unit(0.2, "cm"), type = "closed")
) +
annotate(
"text",
x = annee_max - 13, y = age_max - 7,
label = label_max,
hjust = 1, vjust = 1, size = 3.1, colour = "grey20",
lineheight = 0.95
) +
scale_x_continuous(breaks = scales::pretty_breaks(n = 10)) +
scale_y_continuous(expand = expansion(mult = c(0.02, 0.12))) +
scale_colour_viridis_d(option = "D") +
labs(
x = NULL, y = NULL,
title = "Quel âge a, chaque année, la génération la plus nombreuse ?",
subtitle = "Âge au 1er janvier de chaque année de la génération (cohorte de naissance) la plus nombreuse à cette date",
caption = "Source : Insee, estimations de population et projections de population 2026. Graphique : Patrick Aubert."
) +
theme_minimal(base_size = 12) +
theme(
legend.position = "none",
plot.title = element_text(face = "bold", size = 15, margin = margin(b = 4)),
plot.subtitle = element_text(colour = "grey30", size = 10, margin = margin(b = 12)),
plot.caption = element_text(colour = "grey50", size = 8, hjust = 0, margin = margin(t = 10)),
panel.grid.minor = element_blank(),
panel.grid.major.x = element_blank(),
panel.grid.major.y = element_line(colour = "grey90", linewidth = 0.3),
axis.text = element_text(colour = "grey30"),
plot.background = element_rect(fill = "white", colour = NA),
plot.margin = margin(15, 20, 10, 15)
)
g
